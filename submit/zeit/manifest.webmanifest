{
  "name": "SubZeit",
  "short_name": "SubZeit",
  "description": "Zeit erfassen und planen im Viertelstundentakt.",
  "lang": "de-CH",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0b0a12",
  "theme_color": "#0b0a12",
  "categories": ["business", "productivity"],

  "icons": [
    { "src": "../ui/marke.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "../ui/marke-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "../ui/marke-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "../ui/marke-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],

  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/json": [".submitzeit"] },
      "icons": [{ "src": "../ui/marke-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],

  "shortcuts": [
    { "name": "Heute", "url": "./?heute=1" },
    { "name": "Wochenplanung", "url": "./?seite=woche" }
  ]
}
